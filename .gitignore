# ==========================================
# JewelMind Master .gitignore
# ==========================================

# Environments & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Type Checking & Linting
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.vite/
dist-ssr/
*.local

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# AI & Machine Learning Artifacts (Model Weights)
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.engine
*.tflite
*.h5
*.keras
*.joblib
*.pkl
*.pickle

# Datasets & Outputs (Keep structure, ignore bulky data)
datasets/raw/*
!datasets/raw/.gitkeep
!datasets/raw/README.md
datasets/processed/*
!datasets/processed/.gitkeep
!datasets/processed/README.md
datasets/annotations/*
!datasets/annotations/.gitkeep
!datasets/annotations/README.md
outputs/
generated/
runs/
wandb/

# Temporary / Scratch
scratch/
tmp/
temp/
*.log
*.md
