# ==============================================================================
# JewelMind Global Docker Ignore File
# Prevents large assets, caches, secrets, and datasets from entering build context
# ==============================================================================

# Version Control & IDE
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets & Environment Files (NEVER bake secrets into images)
.env
.env.*
!.env.example

# Python Caches & Environments
__pycache__
*.py[cod]
*$py.class
.pytest_cache
.coverage
htmlcov
.mypy_cache
.ruff_cache
venv
.venv
env
ENV

# Node / Frontend Caches & Artifacts
node_modules
frontend/node_modules
dist
frontend/dist
.cache
.vite
frontend/.vite
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Models & Weights (MOUNTED AT RUNTIME VIA DOCKER VOLUMES)
models/
outputs/
runs/
*.pt
*.safetensors
*.bin
*.onnx
*.ckpt

# Datasets (MOUNTED AS NEEDED, NOT BAKED INTO IMAGES)
ai/rendering/datasets/raw/
ai/rendering/datasets/train/
ai/rendering/datasets/val/
ai/rendering/datasets/augmented/

# Scratch & Logs
scratch/
*.log
alembic.log
