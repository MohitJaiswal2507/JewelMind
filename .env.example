# ==============================================================================
# JewelMind Environment Variables Template (.env.example)
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend & Database Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Vite Build Time & Runtime)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 3. Backend API Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
BACKEND_PORT=8000
JWT_SECRET_KEY=your-random-secret-key-at-least-32-chars-long
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. AI Inference Worker Configuration (Local RTX 4060 / Conda `tgpu`)
# ------------------------------------------------------------------------------
AI_WORKER_PORT=8001
AI_WORKER_URL=http://localhost:8001
AI_WORKER_TIMEOUT=120

# ------------------------------------------------------------------------------
# 5. Local Model Paths & Directories (Native Workspace Defaults)
# ------------------------------------------------------------------------------
JEWELMIND_MODEL_DIR=./models
JEWELMIND_OUTPUT_DIR=./outputs
JEWELMIND_RUNS_DIR=./runs
JEWELMIND_FINAL_CONTROLNET_DIR=./outputs/rendering_v2_controlnet/controlnet_rendering_v2_final
JEWELMIND_LORA_DIR=./outputs/appearance_lora/jewellery_lora_final
JEWELMIND_SD_DIR=./models/diffusion/models--runwayml--stable-diffusion-v1-5/snapshots/451f4fe16113bff5a5d2269ed5ad43b0592e9a14

# ------------------------------------------------------------------------------
# 6. Google Gemini AI Configuration (Design Understanding & Prompt Enhancement)
# ------------------------------------------------------------------------------
# Authoritative model setting: fully configurable via environment variable.
# Free-tier compatible models include: gemini-2.5-flash, gemini-2.0-flash, etc.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
