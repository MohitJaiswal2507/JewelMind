# ==========================================
# JewelMind Environment Variables Template
# ==========================================
# Copy this file to .env and fill in the values.
# NEVER commit real .env files with actual secrets to version control.

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true

# Service URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Backend & Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewelmind

# Supabase Configuration (Free Tier Storage & Auth/DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=jewelmind-assets

# Authentication / Security
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Worker Configuration
AI_WORKER_URL=http://localhost:8001
AI_WORKER_TOKEN=local-worker-secret-token
AI_DEVICE=cuda
USE_REMOTE_WORKER=false
HUGGINGFACE_API_TOKEN=your-optional-hf-token
